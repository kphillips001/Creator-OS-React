# Telegram replies are enabled by default. Set to false for receive-only mode.
TELEGRAM_REPLIES_ENABLED=true
TELEGRAM_ALLOWED_FANVUE_HOSTNAMES=fanvue.com,www.fanvue.com
# Dormant fallback only. When absent or false, no DM challenge is created or consumed.
TELEGRAM_FANVUE_DM_IDENTITY_VERIFICATION_ENABLED=false

# Launcher supervision is opt-in. These switches start processes only and do
# not enable runtime mode, automation, sends, or module authorization.
CREATOR_OS_LAUNCH_TELEGRAM=false
CREATOR_OS_LAUNCH_BACKGROUND_OPERATIONS=true
CREATOR_OS_LAUNCH_COMMERCE_RECONCILIATION=false
COMMERCE_RECONCILIATION_INTERVAL_SECONDS=30
# Required for non-local access to temporary Developer Tools.
CREATOR_OS_DEVELOPER_KEY=
CREATOR_OS_LAUNCH_OUTREACH=false
CREATOR_OS_LAUNCH_DELAYED_MESSAGES=false
CREATOR_OS_LAUNCH_MASS_PPV=false
MASS_PPV_LIVE_SEND_ENABLED=false
CREATOR_OS_LAUNCH_WALL_WORKER=false
CREATOR_OS_LAUNCH_FANVUE_COMMERCIAL_PUBLICATIONS=false

# Fanvue OAuth callback destinations. Keep the legacy callback for Streamlit;
# React Administration uses its own FastAPI callback and returns to Vite.
FANVUE_REDIRECT_URI=http://localhost:8000/callback
FANVUE_REACT_REDIRECT_URI=http://localhost:8001/api/v1/administration/providers/fanvue/callback
CREATOR_OS_REACT_URL=http://localhost:5174

# Grok Vision image understanding.
GROK_VISION_MODEL=grok-4.5

# OpenAI-powered chat and caption helpers.
OPENAI_API_KEY=

# Telegram social publishing.
TELEGRAM_BOT_TOKEN_AVA=
TELEGRAM_CHAT_ID_AVA=
TELEGRAM_OPERATOR_ALERT_CHAT_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_VAULT_CHANNEL_ID=
TELEGRAM_CONTENT_VAULT_URL=
CASHAPP_TIP_URL=https://cash.app/$AvaBlackthorne
TELEGRAM_CHAT_URL=https://t.me/avablackthorne
TELEGRAM_MAIN_CHANNEL_URL=
TELEGRAM_AVA_CHAT_URL=
DMGATE_URL_AVA=
AVA_FANVUE_URL=

# Creator CMS content storage.
CMS_ROOT=D:\Ava_CMS
CONTENT_ROOT=D:\Ava_CMS\Content

# Durable canonical-reference hosting and WaveSpeed transport safety.
HOSTED_REFERENCE_VERIFY_TTL_SECONDS=86400
HOSTED_REFERENCE_MAX_AGE_SECONDS=518400
HOSTED_REFERENCE_RETRY_COUNT=3
HOSTED_REFERENCE_RETRY_BACKOFF_SECONDS=2,5
HOSTED_REFERENCE_VERIFY_TIMEOUT_SECONDS=15
WAVESPEED_TRANSPORT_TIMEOUT_SECONDS=120
GROK_HTTP_TIMEOUT_SECONDS=90
CREATIVE_TAG_API_DEADLINE_SECONDS=100
CREATOR_OS_UNLOCK_TOKEN_SECRET=
# Required for customer-facing commerce. Must be an externally reachable HTTPS origin.
CREATOR_OS_PUBLIC_API_URL=
PRIVATE_CHAT_FINGERPRINT_IDENTITY_BOOTSTRAP_ENABLED=false
CONTROLLED_AUTONOMY_TEST_ENABLED=false
CONTROLLED_AUTONOMY_TELEGRAM_USER_ID=
CONTROLLED_AUTONOMY_TELEGRAM_CHAT_ID=
# Temporary controlled-test-only wait bypass. Must be false before Session 5 certification.
SESSION_5_PACING_BYPASS_ENABLED=false
# Disabled by default outside the canonical local-development launcher.
CREATOR_OS_DEV_AUTO_RELOAD=false
TELEGRAM_BUSINESS_COMMERCIAL_TRANSPORT_ENABLED=false
TELEGRAM_BUSINESS_CONNECTION_LIFECYCLE_ENABLED=false
TELEGRAM_BUSINESS_OWNER_USER_ID=
TELEGRAM_BUSINESS_BOT_ID=
